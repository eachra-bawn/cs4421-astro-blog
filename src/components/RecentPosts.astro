---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<ol>
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>{post.data.title}</a>
			</li>
		))
	}
</ol>
