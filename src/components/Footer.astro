---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Oisín Mulhall.
	<nav class="social-links" aria-label="Social links">
		<a href="/rss.xml" aria-label="RSS feed">
			<p>RSS</p>
		</a>
	</nav>
</footer>
<style>
	footer {
		font-family: monospace;
		font-size: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		padding: 2em 1em 2em 1em;
		color: rgb(var(--black));

		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		padding: 2rem;
		margin-top: 0;
	}
	.social-links a {
		display: flex;
		align-items: center;
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.social-links svg {
		width: 75%;
		/*color: #000;*/
	}
</style>
