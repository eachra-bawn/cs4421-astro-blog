---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import RecentPosts from "../components/RecentPosts.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>
				software engineer.
				<br />
				studying @ University of Limerick
			</h1>
			<p>
				Hi! I'm a first-year student in <a href="https://software-engineering.ie/">ISE</a>.
				<br />I enjoy making thing that run fast, look aesthetic, and serves users!.
			</p>
			<!-- <hr /> -->
			<h3>Most recent blog posts:</h3>
			<RecentPosts />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding: 20px 10px;
	}
	h1 {
		margin-top: 20px;
		margin-bottom: 20px;
	}

	h3 {
		margin-top: 20px;
		margin-bottom: 20px;
	}
	p a {
		text-decoration: underline;
		transition: font-size 0.5s var(--bezier);
	}
	p a:hover {
		font-size: 1.5em;
	}
	p {
		color: rgb(var(--black));
		margin-bottom: 40px;
	}
</style>
